---
profile: production

skip_list:
  # User-facing variables share the collection-wide mp_ prefix instead of the
  # role-name prefix (mp_podman_*, mp_kubevirt_*), so mp_defaults.<backend>
  # and mp.<backend> read the same in every role.
  - var-naming[no-role-prefix]

exclude_paths:
  - .build/
  - .github/
  - changelogs/
