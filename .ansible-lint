---
# ansible-lint configuration for david_igou.molecule_provisioners
profile: basic

skip_list:
  # The collection uses an mp_podman_* / mp_kubevirt_* namespace convention
  # that intentionally differs from the role-name prefix that lint expects.
  - var-naming[no-role-prefix]

# ansible-lint walks the whole repo by default. These paths are tooling /
# CI / docs / specs — not collection content — so they shouldn't be linted
# against ansible-lint's rules.
exclude_paths:
  - .ansible/
  - .devcontainer/
  - .github/
  - .pre-commit-config.yaml
  - .vscode/
  - changelogs/
  - docs/superpowers/
  - pyproject.toml
  - tests/integration/conftest.py
  - tox-ansible.ini
