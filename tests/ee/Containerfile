FROM docker.io/library/python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
RUN apt-get update && apt-get install -y --no-install-recommends git make openssh-client sshpass && rm -rf /var/lib/apt/lists/*
COPY lint-requirements.txt test-requirements.txt requirements.txt /tmp/requirements/
RUN python -m pip install --no-cache-dir -r /tmp/requirements/lint-requirements.txt -r /tmp/requirements/test-requirements.txt -r /tmp/requirements/requirements.txt
COPY . /tmp/collection/
RUN ansible-galaxy collection install /tmp/collection -p /opt/ansible/collections && ansible-galaxy collection install -r /tmp/collection/test-requirements.yml -p /opt/ansible/collections
ENV ANSIBLE_COLLECTIONS_PATH=/work/.build:/opt/ansible/collections
WORKDIR /work
